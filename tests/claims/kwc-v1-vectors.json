    {"id": "C50", "input": "A1+2 1000元", "expect": {"kind": "NO_MATCH", "keyword": "", "quantity": 0, "explicit": false}},
    {"id": "C51", "input": "1000", "expect": {"kind": "MATCH", "keyword": "1000", "quantity": 1, "explicit": false}},
    {"id": "C52", "input": "A1+1000", "expect": {"kind": "INVALID_QUANTITY", "keyword": "A1", "quantity": 0, "explicit": false}},
    {"id": "C53", "input": "A1+02", "expect": {"kind": "INVALID_QUANTITY", "keyword": "A1", "quantity": 0, "explicit": false}},
    {"id": "C54", "input": "0912345678", "expect": {"kind": "MATCH", "keyword": "0912345678", "quantity": 1, "explicit": false}},
    {"id": "C55", "input": "A1+2 0912-345-678", "expect": {"kind": "NO_MATCH", "keyword": "", "quantity": 0, "explicit": false}},
    {"id": "C56", "input": "A1+0", "expect": {"kind": "INVALID_QUANTITY", "keyword": "A1", "quantity": 0, "explicit": false}},

    {"id": "C60", "input": "A1 +2", "expect": {"kind": "NO_MATCH", "keyword": "", "quantity": 0, "explicit": false}},
    {"id": "C61", "input": "A1+ 2", "expect": {"kind": "NO_MATCH", "keyword": "", "quantity": 0, "explicit": false}},
    {"id": "C62", "input": "Ａ１　＋２", "expect": {"kind": "NO_MATCH", "keyword": "", "quantity": 0, "explicit": false}},
    {"id": "C63", "input": "a1+2", "expect": {"kind": "MATCH", "keyword": "A1", "quantity": 2, "explicit": true}},
    {"id": "C64", "input": "\tA1+2\n", "expect": {"kind": "MATCH", "keyword": "A1", "quantity": 2, "explicit": true}},
    {"id": "C65", "input": "A1​+2", "expect": {"kind": "NO_MATCH", "keyword": "", "quantity": 0, "explicit": false}},

    {"id": "C70", "input": "我要A1", "expect": {"kind": "MATCH", "keyword": "A1", "quantity": 1, "explicit": false}},
    {"id": "C71", "input": "A1", "expect": {"kind": "MATCH", "keyword": "A1", "quantity": 1, "explicit": false}},
    {"id": "C72", "input": "A1好看", "expect": {"kind": "MATCH", "keyword": "A1", "quantity": 1, "explicit": false}},

    {"id": "C80", "input": "A1➕2", "expect": {"kind": "NO_MATCH", "keyword": "", "quantity": 0, "explicit": false}},
    {"id": "C81", "input": "A1﹢2", "expect": {"kind": "NO_MATCH", "keyword": "", "quantity": 0, "explicit": false}},
    {"id": "C82", "input": "ABCDEFGHIJKLMNOP+1", "expect": {"kind": "MATCH", "keyword": "ABCDEFGHIJKLMNOP", "quantity": 1, "explicit": true}},
    {"id": "C83", "input": "ABCDEFGHIJKLMNOPQ+1", "expect": {"kind": "NO_MATCH", "keyword": "", "quantity": 0, "explicit": false}},
    {"id": "C84", "input": "A1+2", "pad_to_bytes": 256, "pad": " ", "expect": {"kind": "MATCH", "keyword": "A1", "quantity": 2, "explicit": true}},
    {"id": "C85", "input": "A1+2", "pad_to_bytes": 257, "pad": " ", "expect": {"kind": "NO_MATCH", "keyword": "", "quantity": 0, "explicit": false}},
    {"id": "C86", "input_hex": "4131ff", "expect": {"kind": "NO_MATCH", "keyword": "", "quantity": 0, "explicit": false}}
  ]
}
