# File: deploy/env/compose.env.example -> copy to /etc/live-commerce/compose.env (0640 root:root)
# Purpose: the ONLY home of cross-service values (deploy-design §11.1). deploy/compose.yml
#   interpolates them into wiring (hosts -> Caddy sites and origins, one TTL -> api "<N>s" and
#   storefront "<N>", shared flags -> api + admin + storefront) so services cannot diverge.
# Runs as/in: read on the host by `docker compose --env-file` (through deploy/scripts/lib.sh
#   lc_compose) and by every deploy/scripts/*.sh via lc_load_env. Never mounted into containers.
# Reads secrets: none. This file must NEVER contain a secret; secrets are files in LC_SECRETS_DIR.
# Used by: compose.yml (all services), preflight.sh (P01, P06, P08, P11-P14), secrets-init.sh
#   (LC_SECRETS_DIR/GID, LC_PG_HOST/SSLMODE for DSNs), deploy.sh, pg-ops.sh, watchdog.sh, smoke.sh.
# Status: DESIGN. Placeholders only (example.com, CHANGE_ME); preflight P01/P11 refuse them
#   in production.
# Change rules: KEY=VALUE lines, no inline comments, no `export`. The shell environment
#   overrides this file (Compose precedence); deploy.sh uses that to pass IMAGE_TAG for
#   upgrade/rollback AND rewrites the IMAGE_TAG line here (atomic rename, owner/mode kept) just
#   before `up -d`, so every other Compose entry point resolves the deployed tag (review P1).

# --- Compose -------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=live-commerce
# db,app = single host. Add payments-sandbox (Phase A) or payments-live (Phase B, owner
# approval), meta (blocked by the meta-runtime gate). pg-ops.sh adds `ops` by itself.
COMPOSE_PROFILES=db,app,payments-sandbox
# git sha12 of the images built by deploy/scripts/build-images.sh (lc-go/admin/storefront/caddy).
# Maintained by deploy.sh first|upgrade|app-rollback; do not edit by hand (watchdog W10 = drift).
IMAGE_TAG=CHANGE_ME_GIT_SHA12
LC_IMAGE_PREFIX=lc
# production | staging | smoke (smoke relaxes host-name and owner checks; never on a real host).
LC_ENVIRONMENT=production

# --- Edge (published by the edge-netns container) ------------------------------------------
LC_BIND_ADDR=0.0.0.0
LC_HTTP_PORT=80
LC_HTTPS_PORT=443
# Lowercase FQDNs, all distinct, DNS A/AAAA -> this host (preflight P14).
LC_ADMIN_HOST=admin.example.com
LC_STORE_HOST=shop.example.com
LC_API_HOST=api.example.com
LC_HOOKS_HOST=hooks.example.com
# Optional: this host's public IP for preflight P14 when the host sits behind NAT.
LC_PUBLIC_IP=

# --- Host paths ----------------------------------------------------------------------------
LC_ENV_DIR=/etc/live-commerce/env
LC_SECRETS_DIR=/etc/live-commerce/secrets
LC_SECRETS_GID=10500
LC_BACKUP_DIR=/var/backups/live-commerce
LC_STATE_DIR=/var/lib/live-commerce

# --- Database addressing (used by secrets-init.sh to derive DSN secret files) ----------------
# Single host: postgres + disable (traffic never leaves the internal backend network).
# Two hosts: DB private IP + verify-full (preflight P12).
LC_PG_HOST=postgres
LC_PG_SSLMODE=disable

# --- Shared feature flags (0|1) ------------------------------------------------------------
LC_IDENTITY_ENABLED=1
# OIDC issuer URL of the owner's IdP (blocker B2, owner decision O2).
LC_OIDC_ISSUER=https://idp.example.com/
LC_ONBOARDING_ENABLED=1
LC_ONBOARDING_CURRENCIES=TWD
LC_BUYER_ENABLED=1
# 60..2592000 seconds; api receives "<N>s", storefront "<N>".
LC_BUYER_SESSION_TTL_SECONDS=2592000

# --- Readiness gates -----------------------------------------------------------------------
# 0 = live.media_plan_ready() is informational (Studio/media not deployable; the gate is also
# false on every LOGICALLY restored DB, see deploy/postgres/ops/verify.sql). Set 1 only once
# Studio/media are deployable and the gate is restore-stable (REQUIRES_INTEGRATOR).
LC_REQUIRE_MEDIA_GATE=0

# --- Alerts (optional) ---------------------------------------------------------------------
# watchdog.sh POSTs only failing check ids (never values) here when set.
LC_ALERT_WEBHOOK_URL=
