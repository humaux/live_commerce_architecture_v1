# File: deploy/env/api.env.example -> copy to ${LC_ENV_DIR}/api.env (0640 root:root)
# Purpose: per-service KNOBS for cmd/api only. Wiring (LISTEN_ADDR, origins, *_FILE secrets,
#   shared flags) lives in deploy/compose.yml; redefining any of it here fails preflight P06.
# Runs as/in: env_file of service "api" (lc-go /app/bin/api, UID 65532, edge netns).
# Reads secrets: none here (secrets are files). Used by: compose.yml api; preflight P06/P08/P09.
# Status: DESIGN. Change rules: allowed keys are exactly the ones below (+ TZ). Forbidden
#   everywhere: COMMERCE_IDENTITY_ALLOW_LOOPBACK_TESTS, COMMERCE_FIXTURE_*, LC_TEST_* (P07).

# Merchant PSP-credential CRUD (needs LC_IDENTITY_ENABLED=1).
COMMERCE_ACCOUNTS_ENABLED=1
# Hosted payment start (needs LC_BUYER_ENABLED=1 and the matching payments-* profile).
COMMERCE_BUYER_PAYMENT_ENABLED=1
# FB/IG webhook ingress (needs the `meta` profile + commerce_meta_apps_json, an owner secret from the
# Meta developer console). Comment intake -> claims also needs the `claims` profile (claims-worker).
COMMERCE_META_WEBHOOK_ENABLED=0
# Owner cancelled PAYUNi: notify ingress remains unmounted; preflight P06 refuses enabling it.
COMMERCE_PAYUNI_NOTIFY_ENABLED=0
# Studio = live-session planning + keyword claims + claim-source (R1 ruling G2). Needs LC_IDENTITY_ENABLED=1
# (the API refuses Studio without signed identity); preflight P06 checks it.
COMMERCE_STUDIO_ENABLED=1
# Keyword claims + the claim-source (comment post binding) routes. Needs COMMERCE_STUDIO_ENABLED=1 (P06) and
# the commerce_claims_label_key secret (compose wires it).
COMMERCE_CLAIMS_ENABLED=1
# MUST stay 0: LiveKit media planning is MOCK-only and the media worker is not deployable (B5, F11).
# preflight P06 enforces it; with 0 the media routes are not mounted (404).
COMMERCE_STUDIO_MEDIA_ENABLED=0
# OIDC client id registered at the IdP (redirect URI https://<LC_ADMIN_HOST>/api/auth/callback).
COMMERCE_OIDC_CLIENT_ID=CHANGE_ME_CLIENT_ID
# Stable label stored in identity.login_flows.provider_key (1-128 bytes, not a secret).
# Never change it after the first merchant login.
COMMERCE_IDENTITY_PROVIDER_KEY=oidc-primary-v1
# Merchant session lifetime, Go duration 5m..24h.
COMMERCE_SESSION_TTL=8h
# SANDBOX | LIVE (PROVIDER_MOCK is test-only and has no env path). LIVE = real money, owner approval.
# Stripe (LC_STRIPE_ENABLED in compose.env): LIVE admits Stripe only with LC_STRIPE_LIVE_ENABLED=1 +
# LC_STRIPE_LIVE_APPROVAL_REF in compose.env (stripe-live-enable-v1 LD6); without the pair the API refuses it.
COMMERCE_PAYMENT_PROFILE=SANDBOX
# The ECPay logistics environment follows this profile; its switch is LC_CVS_ECPAY_ENABLED in compose.env (wiring, not a knob here).
# Merchant Meta ads (meta-ads-v1). Empty = routes unmounted and nothing else is read. When set, the other
# three are required, commerce_meta_ads_app_secret must be supplied (P09), the `ads` profile must run
# ads-worker (P06), and ruling B15 keeps it empty until migrations/0080 (ads-capi) is merged (P06).
# App 大梦 = 4291253377792879 (ruling O-C); CONFIG_ID from Facebook Login for Business; redirect URI must be
# https://<LC_ADMIN_HOST>/api/ads/meta/callback, registered in the Meta app dashboard (owner step §11).
COMMERCE_META_ADS_APP_ID=
COMMERCE_META_ADS_CONFIG_ID=
COMMERCE_META_ADS_REDIRECT_URI=
COMMERCE_META_ADS_GRAPH_VERSION=v26.0
# Merchant Facebook Page / Instagram connect (meta-connect, Settings card "Facebook 主頁 / Instagram"). Empty CONFIG_ID = routes
# unmounted and nothing else is read. When set: COMMERCE_META_WEBHOOK_ENABLED=1 and LC_IDENTITY_ENABLED (preflight P06), the other two
# values below are required (P08), and the Meta app is the one in commerce_meta_apps_json (no extra secret). The api seals Page tokens to the
# HPKE PUBLIC ring only (commerce_meta_page_hpke_public_keys_json); the private ring is claims-worker-only. CONFIG_ID is the Facebook
# Login for Business configuration; REDIRECT_URI must equal https://<LC_ADMIN_HOST>/api/meta/callback and be registered in the Meta
# app dashboard (docs/runbooks/deploy.md §Meta). Pilot values (app 大梦, owner-registered 2026-10-01, not secrets):
#   COMMERCE_META_LOGIN_CONFIG_ID=2952863798433821  COMMERCE_META_LOGIN_REDIRECT_URI=https://admin.xgdwm.com/api/meta/callback
COMMERCE_META_LOGIN_CONFIG_ID=
COMMERCE_META_LOGIN_REDIRECT_URI=
COMMERCE_META_LOGIN_GRAPH_VERSION=v26.0
# Meta health UI: only owner-verified Advanced Access permissions; empty = pre-review status.
COMMERCE_META_ADVANCED_ACCESS=
# Receiver probe must be owner-confirmed; 0 keeps DM capability unconfirmed.
COMMERCE_META_DM_RECEIVER_CONFIRMED=0
TZ=UTC
