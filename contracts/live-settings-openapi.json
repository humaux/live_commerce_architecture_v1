      "put": {
        "operationId": "setSoldOutReply",
        "description": "Requires live:manage. Exact non-null four-field JSON. Select a merchant-published template ID/version returned by message-templates; every fixed template is refused, including the read default. SQL owns private_reply kind, body length and product.name-only placeholder rules. Setting, audit and receipt commit together. Same key/body replays its original result even after expected_version becomes stale; different body/key reuse or stale CAS returns 409. No query. Every response private, no-store.",
        "security": [
          {
            "merchantBearer": []
          }
        ],
        "parameters": [
          {
            "name": "store_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Server validates access to this store through the merchant bearer; never accepts tenant scope from input."
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{8,128}$"
            },
            "description": "Exactly one canonical header value."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
