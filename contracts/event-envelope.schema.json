{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DomainEventEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_version",
    "tenant_id",
    "store_id",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "occurred_at",
    "recorded_at",
    "causation_id",
    "correlation_id",
    "payload_ref"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": 1
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "store_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "causation_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "受控内部引用；不得传任意URL、token或原始PII。"
    }
  },
  "$comment": "定义租户/店铺事件；不作为对外输入认证依据。时序与作用域仍须运行时校验。"
}
