{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "task_id",
    "base_commit",
    "head_commit",
    "role",
    "actual_model",
    "reasoning_effort",
    "worktree",
    "evidence_level",
    "status",
    "expected_cases",
    "observed_cases",
    "commands",
    "artifacts",
    "unresolved",
    "not_run",
    "started_at",
    "ended_at",
    "reviewer"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "pattern": "^T[0-9]{2}$"
    },
    "base_commit": {
      "type": "string",
      "minLength": 7
    },
    "head_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "actual_model": {
      "type": "string",
      "minLength": 1
    },
    "reasoning_effort": {
      "type": [
        "string",
        "null"
      ]
    },
    "worktree": {
      "type": "string",
      "minLength": 1
    },
    "evidence_level": {
      "enum": [
        "SPEC_MODEL",
        "UNIT",
        "REAL_PG_INTEGRATION",
        "PROVIDER_MOCK",
        "PROVIDER_SANDBOX",
        "LIVE_AUTHORIZED"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "INCONCLUSIVE",
        "NOT_RUN"
      ]
    },
    "expected_cases": {
      "type": "integer",
      "minimum": 0
    },
    "observed_cases": {
      "type": "integer",
      "minimum": 0
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "exit_code",
          "log_path"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "log_path": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "expected_cases": {
            "minimum": 1
          },
          "observed_cases": {
            "minimum": 1
          },
          "commands": {
            "minItems": 1
          },
          "artifacts": {
            "minItems": 1
          },
          "ended_at": {
            "type": "string",
            "format": "date-time"
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$comment": "JSON Schema不证明命令执行、文件存在、预期用例完整性或独立审查身份。运行校验另核对observed/expected、日志和安全门禁。"
}
