{
  "openapi": "3.1.0",
  "info": {
    "title": "Live Commerce Core Contract Draft",
    "version": "0.1.0",
    "description": "8个核心操作的设计草案；不是完整外部API，也没有实现。T01扩展quote/cart/catalog/webhook/OAuth/SSE等接口。安全scheme定义不能替代CSRF、RLS和对象权限实现。"
  },
  "paths": {
    "/v1/storefront/carts/{cart_id}/checkout": {
      "post": {
        "operationId": "beginCheckout",
        "summary": "明确POST确认后校验报价并预留库存；GET/链接扫描不保留库存。",
        "security": [
          {
            "buyerSession": []
          }
        ],
        "parameters": [
          {
            "name": "cart_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/CSRFToken"
          }
        ],
        "responses": {
          "202": {
            "description": "受理或返回当前事实；202不表示远端已成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Checkout"
                }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "缺操作权限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "不存在或无权读取该资源，外部形状相同",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "版本/幂等/库存冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "输入非法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "本系统限流",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "持久服务暂不可用，不能假ACK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "quote_id",
                  "cart_version",
                  "payment_method_class"
                ],
                "properties": {
                  "quote_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "cart_version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "payment_method_class": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                }
              }
            }
          }
        }
      }
    },
