  "components": {
    "securitySchemes": {
      "staffSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "staff_session"
      },
      "buyerSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "buyer_session"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        }
      },
      "CSRFToken": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 256
        }
      }
    },
    "schemas": {
      "Money": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amount_minor",
          "currency"
        ],
        "properties": {
          "amount_minor": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "十进制整数的字符串；不经JavaScript浮点运算。"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "request_id",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "retryable": {
            "type": "boolean"
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        }
      },
      "Operation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "state",
          "version"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "enum": [
              "PLANNED",
              "READY",
              "DISPATCHING",
              "ACKNOWLEDGED",
              "SUCCEEDED",
              "RETRY_WAIT",
              "UNKNOWN",
              "FAILED_FINAL",
              "CANCELLED",
              "BLOCKED_POLICY",
              "STALE_BINDING"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Checkout": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checkout_id",
          "state",
          "amount",
          "operation_id"
        ],
        "properties": {
          "checkout_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "enum": [
              "PENDING_PROVIDER",
              "READY_FOR_BUYER",
              "REQUOTE_REQUIRED",
              "STOCK_UNAVAILABLE",
              "UNKNOWN",
              "COMPLETED",
              "EXPIRED"
            ]
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "next_action": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "REDIRECT",
                  "POLL",
                  "NONE"
                ]
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "仅返回经过provider允许名单验证的地址；该字段不得成为开放重定向。"
              }
            }
          }
        }
      }
    }
  },
