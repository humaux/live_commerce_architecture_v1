{
  "extends": "../../apps/admin/tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "paths": {
      "@/*": [
        "../../apps/admin/*"
      ],
      "@live-commerce/i18n": [
        "../../packages/i18n/src/index.ts"
      ],
      "@live-commerce/ui": [
        "../../packages/ui/src/AppShell.tsx"
      ],
      "@live-commerce/ui/ds": [
        "../../packages/ui/src/ds/index.ts"
      ],
      "@live-commerce/format": [
        "../../packages/format/src/index.ts"
      ],
      "@live-commerce/markdown-lite": [
        "../../packages/markdown-lite/src/index.ts"
      ],
      "react": [
        "../../apps/admin/node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "../../apps/admin/node_modules/@types/react/*"
      ]
    },
    "typeRoots": [
      "../../apps/admin/node_modules/@types"
    ]
  },
  "include": [
    "../../apps/admin/components/ProductImport.tsx",
    "../../apps/admin/components/CollectionManager.tsx",
    "../../apps/admin/components/Ledger.tsx",
    "../../apps/admin/components/ImportWizard.tsx",
    "../../apps/admin/components/ImportWizardSteps.tsx",
    "../../apps/admin/next-env.d.ts",
    "../../tests/admin/ledger.spec.ts",
    "../../tests/admin/import-wizard.spec.ts",
    "../../tests/admin/parity-data-ops.spec.ts",
    "../../tests/admin/parity-customer-import.spec.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}