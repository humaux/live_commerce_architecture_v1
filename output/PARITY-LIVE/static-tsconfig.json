{
  "extends": "../../apps/admin/tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "paths": {
      "@/*": [
        "../../apps/admin/*"
      ],
      "@live-commerce/ui": [
        "../../packages/ui/src/AppShell.tsx"
      ],
      "@live-commerce/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@live-commerce/format": [
        "../../packages/format/src/index.ts"
      ],
      "@live-commerce/i18n": [
        "../../packages/i18n/src/index.ts"
      ],
      "@live-commerce/markdown-lite": [
        "../../packages/markdown-lite/src/index.ts"
      ],
      "react": [
        "../../apps/admin/node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "../../apps/admin/node_modules/@types/react/*"
      ]
    }
  }
