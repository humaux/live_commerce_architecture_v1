diff --git a/apps/admin/components/catalog/parity.css b/apps/admin/components/catalog/parity.css
new file mode 100644
index 000000000..3c8cf7e5e
--- /dev/null
+++ b/apps/admin/components/catalog/parity.css
@@ -0,0 +1,43 @@
+/* Purpose: signed catalog chips, compact product rows and persistent task actions.
+ * Depends on: ProductDocument.css and the shared admin semantic tokens.
+ * Used by: ProductList and CatalogSimplifiedEditor.
+ * Invariants: 44px controls, bounded mobile width, no global shell overrides. */
+.cat-chip-tabs { display:flex; gap:4px; overflow-x:auto; margin-bottom:16px; padding:0 0 1px; }
+.cat-chip-tabs button { flex:0 0 auto; min-height:44px; padding:10px 24px; border:1px solid var(--ui-border); border-radius:5px; background:var(--ui-surface); color:var(--ui-text); font:inherit; }
+.cat-chip-tabs button[aria-pressed="true"] { background:var(--ui-primary-subtle, #eaf6f4); }
+.cat-task-list .cat-list-tools { margin-bottom:16px; padding:0 12px; background:var(--ui-surface); min-height:44px; }
+.cat-select-all { display:flex; gap:20px; align-items:center; min-height:44px; cursor:pointer; }
+.cat-select-all input { width:20px; height:20px; margin:0; accent-color:var(--ui-primary); }
+.cat-task-list .cat-products-table { border:1px solid var(--ui-border); }
+.cat-products-table .pe-product-identity { display:grid; gap:6px; }
+.cat-products-table .cat-row-price { font-weight:600; font-variant-numeric:tabular-nums; }
+.cat-products-table .cat-row-state { color:var(--ui-muted); font-size:13px; }
+.cat-products-table .pe-product-cell { width:100%; }
+.cat-products-table .pe-actions-cell { padding-right:12px; }
+.cat-products-table .product-photo { width:48px; height:48px; flex:0 0 48px; }
+.cat-products-table .pe-row-actions a { border:1px solid var(--ui-border); border-radius:5px; padding:0 12px; text-decoration:none; color:var(--ui-text); }
+.cat-save-bar { position:sticky; bottom:0; z-index:3; display:flex; gap:8px; padding:12px 16px; border-top:1px solid var(--ui-border); background:var(--ui-surface); }
+.cat-task-list .cat-save-bar { position:fixed; left:var(--admin-sidebar-width, 216px); right:0; bottom:0; }
+.cat-task-list:has(.cat-save-bar) { padding-bottom:84px; }
+.cat-task-editor { max-width:760px; border:0; padding:0; background:transparent; }
+.cat-task-editor > form { display:flex; flex-direction:column; min-height:calc(100dvh - 160px); }
+.cat-task-fields { padding:20px 16px; margin:0 0 16px; background:var(--ui-surface); }
+.cat-task-editor .cat-status-radio { display:flex; align-items:center; gap:16px; min-height:44px; font-weight:400; }
+.cat-task-editor .cat-status-radio input { width:20px; height:20px; min-height:20px; accent-color:var(--ui-primary); }
+.cat-editor-links { display:grid; gap:16px; margin-bottom:24px; }
+.cat-editor-links button { width:100%; min-height:44px; background:var(--ui-surface); border:1px solid var(--ui-border); border-radius:5px; color:var(--ui-text); font:inherit; font-weight:600; }
+.cat-task-editor > form > .cat-save-bar { margin-top:auto; }
+.cat-save-bar > :is(button,a) { display:grid; place-items:center; flex:1; min-height:44px; box-sizing:border-box; text-decoration:none; }
+.cat-task-editor > section { padding:20px 16px; background:var(--ui-surface); }
+.cat-stock-floor { color:var(--ui-muted); font-size:13px; margin:0; }
+@media(max-width:680px) {
+  .cat-chip-tabs button { padding:10px 20px; }
+  .cat-task-list .cat-save-bar { left:0; }
+  .cat-products-table tr { grid-template-columns:44px minmax(0,1fr) auto; padding:12px 0; }
+  .cat-products-table .pe-product-cell { grid-column:2; grid-row:1; }
+  .cat-products-table .pe-actions-cell { grid-column:3; grid-row:1; }
+  .cat-task-editor { padding:0; }
+  .cat-task-editor > form { min-height:calc(100dvh - 120px); }
+  .cat-save-bar { margin-left:-16px; margin-right:-16px; }
+  .cat-task-editor .cat-save-bar { margin-left:0; margin-right:0; }
+}
diff --git a/apps/admin/components/customers/parity.css b/apps/admin/components/customers/parity.css
new file mode 100644
