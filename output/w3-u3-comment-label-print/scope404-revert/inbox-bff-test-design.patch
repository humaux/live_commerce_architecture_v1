+const visibleStores = { items: [{ id: store, name: "Synthetic store", currency: "TWD" }] };
+function scopeRace(t: TestContext, fresh: StoreAnswer) {
+  const previous = answer;
+  storesAnswers = [{ status: 200, body: visibleStores }, fresh];
