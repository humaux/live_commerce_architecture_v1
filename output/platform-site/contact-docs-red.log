  'LC_ONBOARDING_ENABLED=1\n' +
  'LC_ONBOARDING_CURRENCIES=TWD\n' +
  'LC_BUYER_ENABLED=1\n' +
  '# 60..2592000 seconds; api receives "<N>s", storefront "<N>".\n' +
  'LC_BUYER_SESSION_TTL_SECONDS=2592000\n' +
