  'LC_HTTP_PORT=80\n' +
  'LC_HTTPS_PORT=443\n' +
  '# Lowercase FQDNs, all distinct, DNS A/AAAA -> this host (preflight P14).\n' +
  'LC_ADMIN_HOST=admin.example.com\n' +
  'LC_STORE_HOST=shop.example.com\n' +
  'LC_API_HOST=api.example.com\n' +
  'LC_HOOKS_HOST=hooks.example.com\n' +
  '# R5 store-domains: the platform base zone; every store is served at https://<handle>.<LC_STORE_BASE_DOMAIN>.\n' +
